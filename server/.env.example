# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nimo

# Comma-separated list of allowed frontend origins for CORS
# Use CLIENT_URLS for multiple origins, or CLIENT_URL for a single one
CLIENT_URLS=https://your-app.vercel.app,http://localhost:5173
# CLIENT_URL=https://your-app.vercel.app

# Server port (defaults to 5000)
PORT=5000
